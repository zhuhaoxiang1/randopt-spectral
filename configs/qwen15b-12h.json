{
  "model": "Qwen/Qwen2.5-1.5B-Instruct",
  "revision": "main",
  "device": "cuda",
  "dtype": "bfloat16",
  "linalg_device": "auto",
  "attention_implementation": "sdpa",
  "batch_size": 16,
  "seed": 42,
  "population": 100,
  "candidate_sampling": "randopt",
  "antithetic": false,
  "original_sigmas": [0.001, 0.002, 0.003],
