  "probe_samples": 32,
  "test_samples": 256,
  "max_new_tokens": 1024,
  "max_prompt_tokens": 1024,
  "reference_max_tokens": 128,
  "diagnostic_heads": 4,
  "svd_cache_entries": 1024,
  "train_path": "../data/spectral/gsm8k_train.jsonl",
  "test_path": "../data/spectral/gsm8k_test.jsonl",
  "reference_path": "../data/spectral/reference.jsonl",
  "output_dir": "../runs/server-12h-s42",
  "methods": [
    {"name": "original_randopt", "kind": "original"},
    {"name": "gaussian_matched", "kind": "gaussian"},
    {"name": "spectral_uv", "kind": "spectral", "side": "both", "distribution": "sign"}
  ]
}
